/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  // "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designai-main",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    // Run worker first only for API routes and SPA navigation.
    // Static assets (JS/CSS/images/fonts) are served directly from the CDN
    // edge — no Worker overhead, no Worker crash risk for asset delivery.
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "unsafe": {
    "bindings": [
      {
        "name": "API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2101",
        "simple": {
          "limit": 10000,
          "period": 60
        }
      },
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2102",
        "simple": {
          "limit": 1000,
          "period": 60
        }
      }
    ]
  },
  /**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  // "dispatch_namespaces": [
  //   {
  //     "binding": "DISPATCHER",
  //     "namespace": "designai-default-namespace",
  //     "remote": true
  //   }
  // ],
  // "containers": [
  //   {
  //     "class_name": "UserAppSandboxService",
  //     "image": "./SandboxDockerfile",
  //     "max_instances": 10,
  //     "instance_type": "standard-3",
  //     "rollout_step_percentage": 100
  //   }
  // ],
  // IMPORTANT: Replace database_id with your own D1 database ID when deploying a new instance.
  // Run `wrangler d1 create designai-db` to create a new DB and get its ID.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "designai-db",
      "database_id": "03673d1b-cbfa-4263-b7ea-d0f9c6921c15",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CodeGeneratorAgent",
        "name": "CodeGenObject"
      },
      {
        "class_name": "UserAppSandboxService",
        "name": "Sandbox"
      },
      {
        "class_name": "DORateLimitStore",
        "name": "DORateLimitStore"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "TEMPLATES_BUCKET",
      "bucket_name": "designai-templates",
      "remote": true
    }
  ],
  // IMPORTANT: Replace id with your own KV namespace ID when deploying a new instance.
  // Run `wrangler kv namespace create DesignAIStore` to create a new namespace and get its ID.
  "kv_namespaces": [
    {
      "binding": "DesignAIStore",
      "id": "50357ff6a3214ab191383937b77f2625",
      "remote": true
    }
  ],
  // "placement": {
  //   "mode": "smart"
  // },
  "migrations": [
    {
      "new_sqlite_classes": [
        "CodeGeneratorAgent",
        "UserAppSandboxService"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "DORateLimitStore"
      ],
      "tag": "v2"
    }
  ],
  "routes": [
    { "pattern": "designai.dev", "custom_domain": true },
    { "pattern": "www.designai.dev", "custom_domain": true }
  ],
  "vars": {
    "TEMPLATES_REPOSITORY": "https://github.com/Digital-platoon/designai-templates",
    "ALLOWED_EMAIL": "",
    "ENABLE_EMAIL_REGISTRATION": "true",
    "SKIP_EMAIL_VERIFICATION": "true",
    "ENABLE_READ_REPLICAS": "true",
    "CLOUDFLARE_AI_GATEWAY": "designai-gateway",
    "MAX_SANDBOX_INSTANCES": "10",
    "SANDBOX_INSTANCE_TYPE": "standard-3",
    "SANDBOX_SERVICE_TYPE": "disabled",
    "CUSTOM_DOMAIN": "designai.dev"
  },
  "workers_dev": true,
  "preview_urls": true
}